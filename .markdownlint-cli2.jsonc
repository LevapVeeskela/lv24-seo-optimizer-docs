{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2.jsonc",
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": false },
    "MD033": { "allowed_elements": ["ShellTabs", "CliTables", "HomePage"] }
  },
  "globs": ["docs/**/*.md"]
}
